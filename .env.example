# Google Gemini API key for server-side AI Field Diagnostics and Chatbot integration
GEMINI_API_KEY=

# Apps Script /exec URL for the Tree Plantation Reporting Workbook (App_Entry
# sheet). Powers the live sheet markers on the ম্যাপ tab via /api/sheet/list.
# Deploy AppsScript.gs (seed/AppsScript.gs) as a web app -- Execute as: Me,
# Who has access: Anyone -- then paste the deployment's /exec URL here.
GAS_WEBHOOK_URL=

# ─── Neon Postgres (added on neon-reconnect branch) ─────────────────────────
# Get both strings from your Neon project dashboard:
#   https://console.neon.tech/app/projects/<project-id>/connection-details
#
# DATABASE_URL  — pooled connection string (pgBouncer, port 5432).
#                Used by Prisma Client at runtime (Vercel serverless, etc).
#                MUST include `pgbouncer=true` and `sslmode=require`.
#                Channel binding (`channel_binding=require`) is recommended.
#
# DIRECT_URL    — direct connection string (no pooler, port 5432).
#                Used by `prisma migrate` ONLY. Migrations cannot run through
#                pgBouncer transaction mode, so Prisma requires a direct URL.
#                Hostname has `-pooler` REMOVED vs DATABASE_URL.
#
# Example shape (placeholder values):
# DATABASE_URL="postgresql://USER:PASS@ep-foo-pooler.region.aws.neon.tech/DB?sslmode=require&pgbouncer=true&channel_binding=require"
# DIRECT_URL="postgresql://USER:PASS@ep-foo.region.aws.neon.tech/DB?sslmode=require&channel_binding=require"
DATABASE_URL=
DIRECT_URL=
