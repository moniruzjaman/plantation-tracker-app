# Google Gemini API key for server-side AI Field Diagnostics and Chatbot integration
GEMINI_API_KEY=

# Apps Script /exec URL for the Tree Plantation Reporting Workbook (App_Entry
# sheet). Powers the live sheet markers on the ম্যাপ tab via /api/sheet/list.
# Deploy AppsScript.gs (seed/AppsScript.gs) as a web app -- Execute as: Me,
# Who has access: Anyone -- then paste the deployment's /exec URL here.
GAS_WEBHOOK_URL=

# ─── Postgres (Prisma) ───────────────────────────────────────────────────────
# Two supported providers -- use whichever you've actually provisioned:
#
# OPTION A: Prisma Postgres (db.prisma.io)
#   Single connection string works for both runtime AND migrations -- no
#   pooled/unpooled split needed, so DATABASE_URL and DIRECT_URL are the
#   SAME value here:
#   DATABASE_URL="postgres://USER:PASS@db.prisma.io:5432/postgres?sslmode=require"
#   DIRECT_URL="postgres://USER:PASS@db.prisma.io:5432/postgres?sslmode=require"
#
# OPTION B: Neon
#   Get both strings from https://console.neon.tech/app/projects/<id>/connection-details
#   DATABASE_URL  — pooled connection string (pgBouncer, port 5432).
#                  Used by Prisma Client at runtime (Vercel serverless, etc).
#                  MUST include `pgbouncer=true` and `sslmode=require`.
#   DIRECT_URL    — direct connection string (no pooler, port 5432).
#                  Used by `prisma migrate` ONLY ​(can't run through pgBouncer
#                  transaction mode). Hostname has `-pooler` removed.
#   Example (placeholder values):
#   DATABASE_URL="postgresql://USER:PASS@ep-foo-pooler.region.aws.neon.tech/DB?sslmode=require&pgbouncer=true&channel_binding=require"
#   DIRECT_URL="postgresql://USER:PASS@ep-foo.region.aws.neon.tech/DB?sslmode=require&channel_binding=require"
#
# After setting these (locally in .env, and in Vercel's project env vars for
# production), run once to create the tables:
#   npx prisma migrate deploy
# This can't be run from within an AI sandbox with restricted networking --
# do it from a machine with normal internet access. `prisma generate` runs
# automatically as part of the Vercel build (already in buildCommand), so
# production doesn't need any extra manual step beyond the env vars + the
# one-time `migrate deploy`.
DATABASE_URL=
DIRECT_URL=
