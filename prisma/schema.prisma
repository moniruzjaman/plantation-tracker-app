// =============================================================================
// Plantation Tracker — Prisma Schema (PostgreSQL)
// =============================================================================
// Relational mapping of the 17-column official monthly proforma
// "০৫ বছরে ২৫ কোটি বৃক্ষ রোপণ কর্মসূচি"
//
// Tables mirror the Google Sheets workbook structure:
//   Officer             — DAE officer profiles (User_Profile sheet)
//   PlantationEntry     — core operational table (App_Entry sheet)
//   CustomUpazila       — crowd-sourced upazila additions
//   GrowthLog           — periodic re-visits to track canopy growth
//   UserProfile         — App user accounts (gamification, auth)
//   SeedSync            — workbook seed data sync tracking
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Officer (User_Profile sheet) ──────────────────────────────────────────
// DAE officer registry. Multiple entries per officer allowed (re-logins,
// device changes). Dedupe in a view if/when needed.

model Officer {
  id                String   @id @default(uuid())
  appSubmissionId   String?  @unique
  shortTitle        String?  // ADD, AAO, AEO, UAO, SAAO...
  title             String?  // অতিরিক্ত উপপরিচালক, উপজেলা কৃষি অফিসার...
  name              String
  mobile            String?
  email             String?  @unique
  deviceId          String?
  district          String?
  upazila           String?
  unionName         String?
  block             String?
  submittedAt       DateTime?
  createdAt         DateTime @default(now())

  @@index([mobile])
  @@index([district, upazila])
}

// ─── PlantationEntry (App_Entry sheet — core operational table) ──────────────
// One row per field visit / form submission. The flat table mirrors the
// Google Sheets columns directly for easy reconciliation.

model PlantationEntry {
  id                String   @id @default(uuid())
  appSubmissionId   String?  @unique  // client-generated UUID for dedup sync
  submittedAt       DateTime?

  // Location — administrative hierarchy
  division          String?
  region            String?
  district          String?
  upazila           String?
  unionName         String?
  village           String?
  block             String?

  locationType      String?  // বাড়ি/আঙিনা, ক্ষেত্র/জমি, সড়কপার্শ্ব...
  seedlingSource    String?  // প্রদর্শনী, প্রণোদনা, নিজস্ব...
  specificAddress   String?
  latitude          Float?
  longitude         Float?

  plantingDate      DateTime?
  speciesName       String?
  speciesCategory   String?  // ফলদ, বনজ, ঔষধি...
  quantity          Int?
  initialNdvi       Float?

  photoUrl          String?
  photoSha256       String?

  farmerName        String?
  farmerMobile      String?
  saaoName          String?
  saaoMobile        String?
  monitoringOfficerName    String?
  monitoringOfficerMobile  String?

  remarks           String?
  verificationHash  String?
  syncedAt          DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Nested growth log records
  growthLogs        GrowthLog[]

  @@index([district, upazila])
  @@index([plantingDate])
  @@index([farmerMobile])
}

// ─── CustomUpazila (crowd-sourced additions) ────────────────────────────────

model CustomUpazila {
  id                String   @id @default(uuid())
  submittedAt       DateTime?
  district          String
  upazila           String
  addedBy           String?
  deviceId          String?
  createdAt         DateTime @default(now())

  @@unique([district, upazila])
}

// ─── GrowthLog (periodic re-visits) ─────────────────────────────────────────

model GrowthLog {
  id                String   @id @default(uuid())
  submittedAt       DateTime?
  entrySubmissionId String?
  entry             PlantationEntry? @relation(fields: [entrySubmissionId], references: [appSubmissionId], onDelete: Cascade)
  observationDate   DateTime?
  ndvi              Float?
  heightCm          Float?
  status            String?
  remarks           String?
  recordedBy        String?
  deviceId          String?
  createdAt         DateTime @default(now())

  @@index([entrySubmissionId])
}

// ─── UserProfile (App accounts — gamification + auth) ───────────────────────
// Admin / Cadre / Monitoring Officer / SAAO / Citizen accounts.
// Separate from Officer table — this is the app's login identity.

model UserProfile {
  id                    String   @id @default(cuid())
  email                 String   @unique
  name                  String   @default("")
  mobile                String   @default("")

  role                  String   @default("citizen") // 'citizen' | 'officer' | 'cadre' | 'admin'

  nid                   String?
  jobId                 String?
  designation           String?
  district              String?
  upazila               String?
  blockId               String?
  photoUrl              String?

  xp                    Int      @default(0)
  greenTokens           Int      @default(0)
  streakCount           Int      @default(0)
  profileCompletionBonus Boolean @default(false)

  bootstrapSource       String?  // 'allow-list' | 'manual' | 'admin-invite'
  invitedBy             String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([role])
  @@index([district])
  @@index([upazila])
}

// ─── SeedSync (workbook sync tracking) ──────────────────────────────────────

model SeedSync {
  id              String   @id @default(cuid())
  syncedAt        DateTime @default(now())
  recordCount     Int
  sourceFileName  String   @default("Tree_Plantation_Reporting_Workbook.xlsx")
  sourceFileHash  String   @default("")
  syncedByEmail   String?
  notes           String?

  @@index([syncedAt])
}
